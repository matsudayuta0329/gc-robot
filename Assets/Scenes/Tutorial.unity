  tutorialData:
  - isTutorial: 0
    message: 
    messages:
    - "\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3078\u3088\u3046\u3053\u305D\u3002\u3053\u3053\u3067\u306F\u6383\u9664\u30ED\u30DC\u30C3\u30C8\u306E\u64CD\u4F5C\u3092\u7DF4\u7FD2\u3057\u307E\u3059\u3002"
    - "\u307E\u305A\u306F\u4F55\u3082\u306A\u3044\u5834\u6240\u3067\u3001\u524D\u5F8C\u79FB\u52D5\u3068\u65CB\u56DE\u3092\u8A66\u3057\u307E\u3057\u3087\u3046\u3002"
    tutorialAction: 0
  - isTutorial: 1
    message: "W / S\u3067\u524D\u5F8C\u79FB\u52D5\u3001A / D\u3067\u65CB\u56DE\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
